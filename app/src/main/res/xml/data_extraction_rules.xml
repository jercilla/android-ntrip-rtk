<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Se excluyen los ajustes de la copia/transferencia:
     contienen las credenciales cifradas con el Keystore, que no se pueden
     descifrar en otro dispositivo porque la clave nunca sale de este. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ajustes_rtk.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ajustes_rtk.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
